# Metrik — Configurações de Conexão com o Supabase
# Copie este arquivo para .env ou .env.local e preencha com as credenciais do seu projeto Supabase.

# URL do seu projeto Supabase (exemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (anon key) do seu projeto Supabase
VITE_SUPABASE_ANON_KEY=sua-anon-public-key-aqui

# OPCIONAL (apenas para aplicar a migração via linha de comando, nunca no app):
# Personal Access Token do Supabase (Account -> Access Tokens). Revogue após usar.
# SUPABASE_ACCESS_TOKEN=sbp_seu_token_aqui
