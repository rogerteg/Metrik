{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MikaInsightsPayload",
  "type": "object",
  "required": ["insights", "generatedAt", "providerUsed"],
  "properties": {
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "severity", "category", "timestamp"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "recommendation": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
          "category": { "type": "string", "enum": ["cycle-time", "wip-bottleneck", "monte-carlo", "sle-risk", "throughput"] },
          "metricValue": { "type": ["string", "number"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "affectedTaskIds": { "type": "array", "items": { "type": "string" } },
          "affectedColumnId": { "type": "string" }
        }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "providerUsed": { "type": "string", "enum": ["gemini", "heuristic-offline"] }
  }
}
