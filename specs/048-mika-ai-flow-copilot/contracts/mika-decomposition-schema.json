{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MikaDecompositionPayload",
  "type": "object",
  "required": ["taskId", "suggestedSubtasks", "timestamp"],
  "properties": {
    "taskId": { "type": "string" },
    "suggestedSubtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "completed"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "completed": { "type": "boolean" }
        }
      }
    },
    "suggestedAcceptanceCriteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "explanation": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
