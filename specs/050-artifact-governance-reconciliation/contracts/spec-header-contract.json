{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecHeaderContract",
  "description": "Schema de validação para o cabeçalho padronizado de especificações funcionais no Metrik (FR-001, FR-002)",
  "type": "object",
  "required": ["featureName", "featureBranch", "created", "status"],
  "properties": {
    "featureName": {
      "type": "string",
      "description": "Título legível da funcionalidade",
      "minLength": 3
    },
    "featureBranch": {
      "type": "string",
      "description": "Identificador da ramificação formal",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "created": {
      "type": "string",
      "description": "Data de criação da especificação",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "description": "Status canônico padronizado",
      "pattern": "^(Draft|Ready for Planning|In Progress|Implemented & Verified \\([0-9]{4}-[0-9]{2}-[0-9]{2}\\))$"
    },
    "input": {
      "type": "string",
      "description": "Descrição original de entrada fornecida pelo usuário"
    }
  },
  "additionalProperties": true
}
